<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <version>1.4.0</version>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>gopay_dotnet_standard_api</RootNamespace>
    <!-- Pinned on purpose: newer language versions make the compiler embed extra attributes
         (e.g. RefSafetyRulesAttribute) into the assembly. 8.0 is the minimum for nullable analysis.
         Its only metadata effect is IsReadOnlyAttribute on the ServerHandlerData getters
         (informational, signatures unchanged). -->
    <LangVersion>8.0</LangVersion>
    <!-- "warnings" = null-safety analysis inside the library only. Unlike "enable", it emits no
         nullable annotations into the public API, so consumers see no change. -->
    <Nullable>warnings</Nullable>
    <!-- Build-time code analysis only; nothing is added to the package. The level is pinned
         so that SDK updates do not introduce new rules unexpectedly. Rule severities are
         configured in .editorconfig. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- CI (GitHub Actions sets CI=true) fails on any new warning in the library.
       NuGet vulnerability audit warnings are excluded: fixing them means changing
       package dependencies, which is a release decision, not a build failure. -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Installs the Husky.Net git hooks (.husky/) on restore, so the pre-commit formatting
       runs for every developer without a manual setup step. Skipped in CI and when HUSKY=0. -->
  <Target Name="Husky" BeforeTargets="Restore;CollectPackageReferences" Condition="'$(HUSKY)' != '0' and '$(CI)' != 'true'">
    <Exec Command="dotnet tool restore" StandardOutputImportance="Low" StandardErrorImportance="High" WorkingDirectory="$(MSBuildThisFileDirectory).." />
    <Exec Command="dotnet husky install" StandardOutputImportance="Low" StandardErrorImportance="High" WorkingDirectory="$(MSBuildThisFileDirectory).." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RestSharp" Version="112.1.0" />
    <PackageReference Include="RestSharp.Serializers.NewtonsoftJson" Version="112.1.0" />
  </ItemGroup>

</Project>
